# Optional API keys — the app works without them via keyless fallback APIs
# (iTunes Search for movies, CheapShark for games, Open Library for books).
# Copy to .env.local and fill in for richer metadata.

# https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=

# https://rawg.io/apidocs
VITE_RAWG_API_KEY=
